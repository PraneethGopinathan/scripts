# Function to create the k8s context right prompt
function k8s_rprompt() {
  if command -v kubectl &>/dev/null; then
    local context_name=$(kubectl config current-context 2>/dev/null)
    if [[ -n "$context_name" ]]; then
      local namespace=$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null)
      namespace=${namespace:-"default"}
      echo "%B%F{yellow}⎈ ${context_name}%f%b %F{cyan}[${namespace}]%f"
    fi
  fi
}

function set_k8s_rprompt() {
  RPROMPT="$(k8s_rprompt)"
}

