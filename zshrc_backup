function kgpwi() {
  local headers=("NAME" "STATUS" "READY" "RESTARTS" "Pod_IP" "PORTS" "AGE" "NODE")
  local widths=(42 8 8 9 15 20 8 30)

  printf "%-${widths[1]}s %-${widths[2]}s %-${widths[3]}s %-${widths[4]}s %-${widths[5]}s %-${widths[6]}s %-${widths[7]}s %-${widths[8]}s\n" \
    "${headers[1]}" "${headers[2]}" "${headers[3]}" "${headers[4]}" "${headers[5]}" "${headers[6]}" "${headers[7]}" "${headers[8]}"

  kubectl get pods -o wide --no-headers | while IFS= read -r line; do
    local pod_name=$(echo "$line" | awk '{print $1}')
    local pod_status=$(echo "$line" | awk '{print $3}')
    local ready=$(echo "$line" | awk '{print $2}' | cut -d'/' -f1)
    local ip=$(echo "$line" | awk '{print $6}')
    local node=$(echo "$line" | awk '{print $7}')
    local age=$(echo "$line" | awk '{print $5}')

    local pod_json=$(kubectl get pod "$pod_name" -o json 2>/dev/null)
    [ -z "$pod_json" ] && continue

    local restarts=$(jq -r '.status.containerStatuses[0].restartCount' <<< "$pod_json")
    local ready_state=$(jq -r '.status.containerStatuses[0].ready' <<< "$pod_json")
    local ports=$(jq -r '[.spec.containers[].ports[]?.containerPort] | join(",")' <<< "$pod_json")

    printf "%-${widths[1]}s %-${widths[2]}s %-${widths[3]}s %-${widths[4]}s %-${widths[5]}s %-${widths[6]}s %-${widths[7]}s %-${widths[8]}s\n" \
      "${pod_name:0:${widths[1]}}" \
      "$pod_status" \
      "$([ "$ready_state" = "true" ] && echo "Ready" || echo "NotReady")" \
      "${restarts:-0}" \
      "$ip" \
      "${ports:-none}" \
      "$age" \
      "$node"
  done
}

