kimg() {
    if [ -z "$1" ]; then
        echo "Usage: kimg <pod-name> [-n namespace]"
        return 1
    fi
    
    local pod_name="$1"
    local namespace_flag=""
    
    # Parse optional namespace flag
    shift
    while [[ $# -gt 0 ]]; do
        case $1 in
            -n|--namespace)
                namespace_flag="-n $2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done
    
    format_images() {
        # If it has @sha256:, show registry/image@SHA(12 chars)
        # Otherwise show as-is (for tagged images)
        awk -F'@sha256:' '{
            if (NF > 1) {
                print $1 "@" substr($2, 1, 12) "..."
            } else {
                print $0
            }
        }'
    }
    
    # Check if pod exists
    if ! kubectl get pod "$pod_name" $namespace_flag &>/dev/null; then
        echo "Error: Pod '$pod_name' not found"
        return 1
    fi
    
    echo "=== POD: $pod_name ==="
    
    # Init containers
    local init_output=$(kubectl get pod "$pod_name" $namespace_flag -o json | jq -r '.spec.initContainers[]? | "\(.name)\t\(.image)"')
    if [ -n "$init_output" ]; then
        echo -e "\n--- INIT CONTAINERS ---"
        echo "$init_output" | format_images | column -t
    fi
    
    # Regular containers
    echo -e "\n--- CONTAINERS ---"
    kubectl get pod "$pod_name" $namespace_flag -o json | jq -r '.spec.containers[] | "\(.name)\t\(.image)"' | format_images | column -t
    
    # Optionally show image pull policy and status
    echo -e "\n--- IMAGE STATUS ---"
    kubectl get pod "$pod_name" $namespace_flag -o json | jq -r '
        .status.containerStatuses[]? | 
        "\(.name)\t\(.imageID // "N/A")\t\(.ready)"
    ' | awk -F'\t' '{
        split($2, parts, "@sha256:")
        if (length(parts) > 1) {
            printf "%s\t%s@%s...\t%s\n", $1, parts[1], substr(parts[2], 1, 12), ($3 == "true" ? "✓" : "✗")
        } else {
            printf "%s\t%s\t%s\n", $1, $2, ($3 == "true" ? "✓" : "✗")
        }
    }' | column -t
}

