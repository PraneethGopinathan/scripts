# Fun utilities
matrix() {
  echo -e "\e[1;40m" ; clear ; while :; do echo $LINES $COLUMNS $(( $RANDOM % $COLUMNS)) $(( $RANDOM % 72 )) ; sleep 0.05; done | awk '{ letters="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*()"; c=$4; letter=substr(letters,c,1);a[$3]=0;for (x in a) {o=a[x];a[x]=a[x]+1; printf "\033[%s;%sH\033[2;32m%s",o,x,letter; printf "\033[%s;%sH\033[1;37m%s\033[0;0H",a[x],x,letter;if (a[x] >= $1) { a[x]=0; } }}'
}

coinflip() {
  if [ $((RANDOM % 2)) -eq 0 ]; then
    echo "🪙 Heads!"
  else
    echo "🪙 Tails!"
  fi
}

dice() {
  echo "🎲 You rolled: $((RANDOM % 6 + 1))"
}

quote() {
  local quotes=(
    "Code is like humor. When you have to explain it, it's bad. - Cory House"
    "First, solve the problem. Then, write the code. - John Johnson"
    "The best error message is the one that never shows up. - Thomas Fuchs"
    "Clean code always looks like it was written by someone who cares. - Michael Feathers"
    "Programming isn't about what you know; it's about what you can figure out. - Chris Pine"
    "The only way to learn a new programming language is by writing programs in it. - Dennis Ritchie"
  )
  local random_index=$((RANDOM % ${#quotes[@]}))
  echo ""
  echo "💭 ${quotes[$((random_index + 1))]}"
  echo ""
}

# Quick utilities
now() { date "+%Y-%m-%d %H:%M:%S" "$@"; }

# Mac-specific utilities
showfiles() { defaults write com.apple.finder AppleShowAllFiles YES && killall Finder "$@"; }
hidefiles() { defaults write com.apple.finder AppleShowAllFiles NO && killall Finder "$@"; }
flushdns() { sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder "$@"; }
battery() { pmset -g batt | grep -E "([0-9]+\%).*" -o | head -1 "$@"; }
cpuinfo() { sysctl -n machdep.cpu.brand_string "$@"; }
meminfo() { vm_stat | head -10 "$@"; }
guntracked() { git ls-files --others --exclude-standard "$@"; }
gcleanall() { git clean -fd -n "$@"; }
gcleanforce() { git clean -fd "$@"; }

# Enable alias expansion
setopt aliases

# History settings
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
export FUNCNEST=1000
alias pip="pip3"
export PATH="$HOME/Documents/scripts:$PATH"

